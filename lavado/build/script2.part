<script>
const PUBLICA=false;
let DIAS=[], FUENTE="semilla";
const CHECK=["Equipos limpios y en condiciones","Imán de la cinta bajo tolvas limpio","Integridad de la cinta de la fosa","Picos de lavado destapados","Tolvas de granel limpias","Malla contra palomas en buen estado","Caños de salmuera y agua limpios","Caños de bajada con tapas","Tanque ecualizador tapado","Tanque verde tapado","Sedimentador tapado","Silos inspeccionados y cerrados"];
const CAUSAS={M:"Mantenimiento",C:"Calidad",P:"Producción",O:"Operativa"};
const $=s=>document.querySelector(s)||(PUBLICA?document.createElement("div"):null);
const esc=v=>String(v??"").replace(/[&<>"]/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;"}[c]));
const min=h=>{if(!h)return null;const[a,b]=String(h).split(":").map(Number);return a*60+b};
const fmtF=f=>f.split("-").reverse().join("/");
const nf=(x,d=1)=>Number(x).toLocaleString("es-AR",{minimumFractionDigits:d,maximumFractionDigits:d});
const fueraPCA=c=>c.ml<100||c.ml>110;
const sm=b=>b===null||b===undefined?'<span class="chip warn">Sin marcar</span>':b?'<span class="chip ok">Sí</span>':'<span class="chip bad">No</span>';
const sino=b=>b===null||b===undefined?"—":b?'<span class="chip ok">Sí</span>':'<span class="chip bad">No</span>';
const arr=v=>Array.isArray(v)?v:[];
function norm(d){
  d.silos=arr(d.silos);d.tolvas=arr(d.tolvas);d.paradas=arr(d.paradas);d.novedades=arr(d.novedades);d.desvios=arr(d.desvios);
  d.checklist=d.checklist||{items:[],purga:{}};d.checklist.items=arr(d.checklist.items);d.checklist.purga=d.checklist.purga||{};
  d.sed=d.sed||{ctrl:[]};d.sed.ctrl=arr(d.sed.ctrl);d.bateas=d.bateas||{cargas:[]};d.bateas.cargas=arr(d.bateas.cargas);d.notas=arr(d.notas);
  const ev=d.paradas.filter(p=>/corte de luz|falla.*(balanza|scada|sistema|sensor)|sin referencia/i.test(p.motivo||""));
  if(!d.evento&&ev.length)d.evento=ev.map(p=>p.motivo).join(" + ");
  if(!d.inicio&&!d.silos.length&&!d.tolvas.length)d.soloBateas=true;
  if(!d.fin){const l=d.silos.filter(x=>x.fin).slice(-1)[0];if(l){d.fin=l.fin;d.finEst=true}}
  return d;
}
function ctrlEsperados(d){return d.inicio&&d.fin?1+Math.floor((min(d.fin)-min(d.inicio))/120):0}
function minParada(p){return p.de&&p.a?min(p.a)-min(p.de):0}
function calc(d){
  const hl=d.inicio&&d.fin?(min(d.fin)-min(d.inicio))/60:0;
  const mp=d.paradas.reduce((s,p)=>s+minParada(p),0);
  const t=d.silos.reduce((s,x)=>s+(typeof x.t==="number"?x.t:0),0);
  const hm=hl-mp/60;
  const ll=llenados(d), tF=ll.reduce((s,x)=>s+x.t,0), mF=ll.reduce((s,x)=>s+x.dur,0), lentos=ll.filter(x=>x.exc>0);
  const s0=d.silos.find(x=>x.ini), g0=d.tolvas.find(x=>x.ini);
  return {hl,mp,t,hm,ll,tF,mF,lentos,lento:lentos.reduce((s,x)=>s+x.exc,0),arr:d.inicio&&s0?min(s0.ini)-min(d.inicio):null,arrTG:d.inicio&&g0?min(g0.ini)-min(d.inicio):null,th:mF>0?tF/(mF/60):0,disp:hl>0?hm/hl*100:0,pcaF:d.sed.ctrl.filter(fueraPCA).length,bat:d.bateas.cargas.length,batNo:d.bateas.cargas.filter(c=>c.apta===false).length,des:d.desvios.length};
}
function alertas(d){
  const a=[];
  if(d.soloBateas){a.push(["neu","Sin lavado: solo carga de bateas"]);const p=d.bateas.cargas.filter(b=>!b.pat).length;if(p)a.push(["warn",p+" batea"+(p>1?"s":"")+" sin patente"]);if(d.bateas.cargas.some(b=>b.apta===false))a.push(["bad","Batea rechazada"]);return a}
  const sinPat=d.bateas.cargas.filter(b=>!b.pat).length; if(sinPat)a.push(["warn",sinPat+" batea"+(sinPat>1?"s":"")+" sin patente"]);
  const sinT=d.silos.filter(s=>typeof s.t!=="number").length; if(sinT)a.push(["warn",sinT+" silo"+(sinT>1?"s":"")+" sin toneladas"]);
  const e=ctrlEsperados(d); if(d.sed.ctrl.length<e)a.push(["warn","Sedimentador: "+d.sed.ctrl.length+" de "+e+" controles"]);
  if(d.sed.ctrl.some(fueraPCA))a.push(["bad","PCA fuera de rango"]);
  const sinMarca=CHECK.filter((_,k)=>!d.checklist.items[k]).length; if(sinMarca)a.push(["warn",sinMarca+" casillero"+(sinMarca>1?"s":"")+" sin marcar"]);
  if(d.checklist.previa!==true)a.push(["warn","Verificación previa sin OK"]);
  if(d.desvios.length)a.push(["bad",d.desvios.length+" desvío"+(d.desvios.length>1?"s":"")]);
  if(d.bateas.cargas.some(b=>b.apta===false))a.push(["bad","Batea rechazada"]);
  const sc=d.paradas.filter(p=>!CAUSAS[p.causa]).length; if(sc)a.push(["warn",sc+" parada"+(sc>1?"s":"")+" sin causa"]);
  if(d.finEst)a.push(["warn","Fin del lavado sin anotar (se toma "+d.fin+")"]);
  if(d.evento)a.push(["bad","Día con corte de luz o falla de sistema"]);
  if(!d.reviso)a.push(["warn","Sin firma del encargado"]);
  return a;
}
const CARGA_TG=34; // t por descarga de granel sin pesar, igual que Parvas y despachos. NO cambiar hasta tener un mes de pesadas (Rodrigo 13/11)
const NORMAL=33, ALIM="36,5", TOL=5; // Tn/h normales a silo (radar), t/h de alimentación del wash, tolerancia en min por llenado
function solape(d,a,b){return d.paradas.reduce((s,p)=>{if(!p.de||!p.a)return s;return s+Math.max(0,Math.min(b,min(p.a))-Math.max(a,min(p.de)))},0)}
// cada llenado de silo con Tn: duración sin paradas y minutos de más contra el ritmo normal (solo si pasa la tolerancia)
function llenados(d){return d.silos.filter(x=>x.ini&&x.fin&&typeof x.t==="number").map(x=>{const a=min(x.ini),b=min(x.fin),par=solape(d,a,b),dur=b-a-par,exc=Math.round(dur-x.t/NORMAL*60);return {silo:x.silo,ini:x.ini,fin:x.fin,t:x.t,dur,par,exc:exc>=TOL?exc:0}})}
const lentosTxt=c=>c.lentos.length?c.lentos.map(x=>`silo ${x.silo} de las ${x.ini}: tardó ${x.dur} min, ${x.exc} de más`).join(" · "):"ningún silo tardó de más";
const completoDia=d=>llenados(d).length>0;
const hs=f=>`<div class="hs">${f.map(([a,b])=>`<span>${a}</span><b>${esc(b)}</b>`).join("")}</div>`;
function dato(k,v,s){return `<div class="dato"><div class="k">${k}</div><div class="v">${v}</div><div class="s">${s||""}</div></div>`}
function tabla(head,rows){return `<div class="tbl"><table><thead><tr>${head.map(h=>`<th${h.startsWith("#")?' class="n"':""}>${h.replace("#","")}</th>`).join("")}</tr></thead><tbody>${rows.join("")}</tbody></table></div>`}
// ---- Bitácora: notas guardadas en la base del artefacto (colección "notas") ----
let NOTAS=[], dbN=null, usr=null, miId=null, puede=false, PERF={};
const notasDe=(tipo,ref)=>NOTAS.filter(n=>n.tipo===tipo&&n.ref===ref);
const autor=n=>n.por==="claude"?"Claude":(PERF[n.por]&&PERF[n.por].name)||"Alguien";
const refTxt=n=>n.tipo==="dia"?"Día "+fmtF(n.ref):n.tipo==="sem"?rotulo(n.ref,"sem"):"General";
function notaHtml(n,conRef){return `<div class="nt">${conRef?`<span class="chip neu">${esc(refTxt(n))}</span>`:""}<p>${esc(n.txt)}</p><div class="pie"><span>${esc(autor(n))}, ${esc(fmtF(String(n.creado||"").slice(0,10)))}</span>${puede?`<button class="lnk" type="button" data-borrar="${esc(n.id)}">Borrar</button>`:""}</div></div>`}
function pintarAnalisis(d){
  const ns=notasDe("dia",d.fecha);
  $("#analisis").innerHTML=(ns.length||puede)?`<div class="anal"><b>Análisis del día</b>${ns.map(n=>notaHtml(n,false)).join("")||'<p class="nota" style="padding:4px 0 0">Todavía sin notas para este día.</p>'}${puede?`<details><summary>Agregar nota de este día</summary><div class="bit-form" style="padding:8px 0 0"><textarea id="anTxt" maxlength="2000" aria-label="Nota del día"></textarea><div class="barra"><button class="btn-pdf" type="button" data-guardar-dia="${esc(d.fecha)}">Guardar nota</button></div></div></details>`:""}</div>`:"";
}
function llenarBitRef(){
  const t=$("#bitTipo").value, r=$("#bitRef");
  r.innerHTML=t==="dia"?[...DIAS].reverse().map(d=>`<option value="${d.fecha}">${fmtF(d.fecha)}</option>`).join(""):t==="sem"?periodos("sem").reverse().map(k=>`<option value="${k}">${rotulo(k,"sem")}</option>`).join(""):'<option value="">No aplica</option>';
  r.disabled=t==="gen";
}
function pintarBit(){
  const f=$("#bitFiltro").value, ns=NOTAS.filter(n=>!f||n.tipo===f);
  $("#bitCuenta").textContent=NOTAS.length+" nota"+(NOTAS.length===1?"":"s");
  $("#bitLista").innerHTML=ns.map(n=>notaHtml(n,true)).join("")||`<p class="vacio" style="padding-top:12px">${dbN?"Todavía no hay notas.":"Las notas no están disponibles en esta vista."}</p>`;
  $("#bitGuardar").disabled=!puede;
}
function pintarNotas(){pintarBit();if(DIAS.length){pintarDia();pintarInd();}}
async function guardarNota(tipo,ref,txt,est){
  txt=String(txt||"").trim(); if(!dbN||!puede||!txt)return false;
  try{await dbN.collection("notas").add({tipo,ref:tipo==="gen"?"":ref,txt:txt.slice(0,2000),por:miId||"anon",creado:new Date().toISOString()});if(est)est.textContent="Nota guardada.";return true}
  catch(e){if(est)est.textContent="No se pudo guardar la nota"+(e&&e.code?" ("+e.code+")":"")+".";return false}
}
async function clicNotas(ev){
  const b=ev.target&&ev.target.closest?ev.target.closest("button"):null; if(!b)return;
  if(b.dataset.borrar){ if(b.dataset.ok!=="1"){b.dataset.ok="1";b.textContent="Confirmar borrado";return} try{await dbN.doc("notas/"+b.dataset.borrar).delete()}catch(e){b.textContent="No se pudo borrar"} }
  else if(b.dataset.guardarDia){ const t=$("#anTxt"); b.disabled=true; const ok=await guardarNota("dia",b.dataset.guardarDia,t?t.value:""); b.disabled=false; if(!ok&&t&&t.value.trim())b.textContent="No se pudo guardar, reintentar"; }
}
async function initNotas(){
  const est=$("#bitEstado"); llenarBitRef(); pintarBit();
  if(!window.claude||!window.claude.use){est.textContent="Las notas no están disponibles en esta vista.";return}
  let db=null; try{[db,usr]=await Promise.all([window.claude.use("db"),window.claude.use("user")])}catch(e){}
  if(!db){est.textContent="Las notas no están disponibles en esta vista.";return}
  dbN=db;
  db.collection("dias").onSnapshot(snap=>{
    if(!snap.docs.length)return;
    DIAS=snap.docs.map(x=>x.data()).filter(d=>d&&d.fecha).sort((a,b)=>a.fecha.localeCompare(b.fecha)).map(d=>norm(JSON.parse(JSON.stringify(d))));
    FUENTE="base";
    const pv=$("#indPer").value;llenarPer();if([...$("#indPer").options].some(o=>o.value===pv))$("#indPer").value=pv;
    pintarTodo();llenarBitRef();
  },()=>{});
  if(usr){try{miId=await usr.id();puede=(await usr.can("data.write"))!==false}catch(e){puede=true}}else puede=true;
  const t=setTimeout(()=>{est.textContent="No se pudieron cargar las notas. Probá abrir de nuevo la página."},10000);
  db.collection("notas").onSnapshot(async snap=>{
    clearTimeout(t);
    NOTAS=snap.docs.map(x=>({id:x.id,...x.data()})).sort((a,b)=>String(b.creado).localeCompare(String(a.creado)));
    const ids=[...new Set(NOTAS.map(n=>n.por).filter(x=>x&&x!=="claude"&&x!=="anon"))];
    if(usr&&ids.length){try{PERF=await usr.profiles(ids)}catch(e){}}
    est.textContent=puede?"":"Solo lectura: no tenés permiso para escribir notas.";
    pintarNotas();
  },e=>{clearTimeout(t);est.textContent="No se pudieron cargar las notas"+(e&&e.code?" ("+e.code+")":"")+"."});
}
function pintarDia(){
  const d=DIAS.find(x=>x.fecha===$("#selDia").value); if(!d)return; const c=calc(d), tz=trazar(d).bat, s0=d.silos.find(x=>x.ini), g0=d.tolvas.find(x=>x.ini);
  const f=d.fuente||{};
  $("#estadoDia").innerHTML=(d.reviso?'<span class="chip ok">Revisado por el encargado</span>':'')+(PUBLICA?"":` <span class="chip neu">${esc(d.operador||"Operador sin anotar")}</span> `+(f.link?`<a class="btn-pdf" href="${esc(f.link)}" target="_blank" rel="noopener">Ver planilla escaneada (PDF ${esc(f.nombre||"")})</a>`:`<span class="chip warn">Sin PDF en Drive${f.nombre?" · "+esc(f.nombre):""}</span>`));
  $("#alertas").innerHTML=alertas(d).map(([k,t])=>`<span class="chip ${k}">${esc(t)}</span>`).join("")||'<span class="chip ok">Sin observaciones</span>';
  pintarAnalisis(d);
  $("#resDia").innerHTML=dato("Sal a silos (radar)",nf(c.t)+" Tn",d.silos.length+" llenados")+dato("Horas de lavado",nf(c.hl),hs([["Inicio proceso",d.inicio||"?"],["Fin proceso",(d.fin||"?")+(d.finEst?" (estimado)":"")]]))+dato("Paradas",c.mp+" min",d.paradas.length?d.paradas.length+" parada"+(d.paradas.length>1?"s":""):"sin paradas")+dato("Puesta en marcha",c.arr!=null?c.arr+" min":"—",c.arr!=null?hs([["Inicio proceso",d.inicio]].concat(g0&&g0.ini?[["Empieza a alimentar TG"+g0.tg,g0.ini]]:[],[["Entra sal al 1er silo",s0.ini]])):"")+dato("Ritmo de lavado",c.mF?nf(c.th)+" Tn/h":"—",c.mF?nf(c.th/NORMAL*100,0)+" % de "+NORMAL+" Tn/h a silo · sobre "+nf(c.mF/60)+" h de llenado":"faltan Tn de los silos")+dato(d.evento?"Perdido por falla":"Llenados lentos (min de más)",c.mF?"~"+c.lento+" min":"—",c.mF?(d.evento&&c.lento?"corte de luz o falla · ":"")+lentosTxt(c):"faltan Tn de los silos")+dato("Bateas",c.bat,c.batNo?c.batNo+" rechazada":"todas aptas")+dato("Desvíos",c.des+c.pcaF,c.pcaF?c.pcaF+" de PCA fuera de rango":"");
  $("#rProd").innerHTML=`<header><h2>Producción de lavado</h2><span class="cod">R-P-XX · hoja 1</span></header><h3>Silos</h3>`+
    tabla(["Silo","Inicio","Lleno","#Min de llenado","#Tn indicadas por el radar","#Ritmo del llenado (Tn/h)"],d.silos.map(s=>{const m=s.ini&&s.fin?min(s.fin)-min(s.ini):null,l=c.lentos.find(x=>x.ini===s.ini&&x.silo===s.silo);return `<tr><td>${esc(s.silo)}</td><td>${esc(s.ini)}</td><td>${esc(s.fin)}</td><td class="n">${m??"—"}${l?` <span class="chip warn">+${l.exc}</span>`:""}</td><td class="n">${typeof s.t==="number"?nf(s.t):'<span class="chip warn">Falta</span>'}</td><td class="n">${typeof s.t==="number"&&m?nf(s.t/m*60):"—"}</td></tr>`}))+
    `<p class="nota">“Ritmo del llenado” = Tn de radar de ese silo ÷ minutos que tardó en llenarse, llevado a una hora. Lo normal es cerca de ${NORMAL} Tn/h. Si un llenado tardó 5 min o más sobre lo normal, al lado de los minutos aparece cuántos de más.</p><h3>Tolvas de granel</h3>`+tabla(["TG","Inicio","Fin","#Min de vaciado"],d.tolvas.map(x=>`<tr><td>TG${esc(x.tg)}</td><td>${esc(x.ini)}</td><td>${esc(x.fin)||"—"}</td><td class="n">${x.ini&&x.fin?min(x.fin)-min(x.ini):"—"}</td></tr>`));
  $("#rParadas").innerHTML=`<header><h2>Paradas y novedades</h2><span class="cod">R-P-XX Producción de lavado · hoja 2</span></header><h3>Paradas</h3>`+
    (d.paradas.length?tabla(["De","A","#Min","Causa","Motivo"],d.paradas.map(p=>`<tr><td>${esc(p.de)}</td><td>${esc(p.a)}</td><td class="n">${minParada(p)}</td><td>${CAUSAS[p.causa]?`<span class="causa c${p.causa}" title="${CAUSAS[p.causa]}">${p.causa}</span>`:"—"}</td><td>${esc(p.motivo)}${p.equipo?` <span class="chip neu">${esc(p.equipo)}</span>`:""}</td></tr>`)):'<p class="vacio">Sin paradas.</p>')+
    `<h3>Novedades</h3>`+(d.novedades.length?tabla(["Hora","Novedad"],d.novedades.map(n=>`<tr><td>${esc(n.h)}</td><td>${esc(n.txt)}</td></tr>`)):'<p class="vacio">Sin novedades.</p>');
  const pu=d.checklist.purga;
  $("#rCtrl").innerHTML=`<header><h2>Control de lavado de sal</h2><span class="cod">R-P-XX</span></header><h3>Antes de arrancar · verificación OK ${sm(d.checklist.previa)}</h3>`+
    `<div class="check">${CHECK.map((i,k)=>`<span class="${d.checklist.items[k]?"":"no"}">${i}</span>`).join("")}<span class="${pu.constante||pu.auto?"":"no"}">Purga: ${pu.constante?"constante abierta":pu.auto?"automatizada verificada":"sin marcar"}</span></div>`+
    `<h3>Desvíos y trazabilidad</h3>`+(d.desvios.length?tabla(["Hora","Silo","Desvío","Acción","Muestra"],d.desvios.map(x=>`<tr><td>${esc(x.h)}</td><td>${esc(x.silo)}</td><td>${esc(x.desvio)}</td><td>${esc(x.accion)}</td><td>${sm(x.muestra)}</td></tr>`)):'<p class="vacio">Sin desvíos.</p>');
  const e=ctrlEsperados(d);
  $("#rSed").innerHTML=`<header><h2>Control de sedimentador</h2><span class="cod">R-P-XX · purga ${esc((d.sed.purga||"sin marcar").toLowerCase())}</span></header>`+
    (d.sed.ctrl.length?tabla(["Hora","#t/h","#PCA ml/15 s","En rango","Barrido"],d.sed.ctrl.map(x=>`<tr><td>${esc(x.h)}</td><td class="n">${x.th!=null?nf(x.th):"—"}</td><td class="n">${x.ml??"—"}</td><td>${fueraPCA(x)?'<span class="chip bad">Fuera</span>':'<span class="chip ok">Sí</span>'}</td><td>${sm(x.barrido)}</td></tr>`)):'<p class="vacio">Sin controles.</p>')+
    `<p class="nota">${d.sed.ctrl.length} control${d.sed.ctrl.length===1?"":"es"} de ${e} esperados (inicio y cada 2 h entre ${d.inicio||"?"} y ${d.fin||"?"}). Rango con 36,5 t/h: 100 a 110 ml cada 15 s.</p>`;
  if(d.soloBateas){const g=d.granel&&d.granel.filas||[],sl='<p class="vacio">Sin lavado este día.</p>';
    $("#resDia").innerHTML=dato("Lavado","Sin lavado","solo carga de bateas")+dato("Bateas",c.bat,c.batNo?c.batNo+" rechazada":"todas aptas")+dato("Tolvas cargadas",g.length,g.length?g.map(x=>x.tolva).join(", ")+" para el próximo arranque":"sin descargas de granel anotadas");
    $("#rProd").innerHTML=`<header><h2>Producción de lavado</h2></header>`+sl;$("#rParadas").innerHTML=`<header><h2>Paradas y novedades</h2></header>`+sl;$("#rCtrl").innerHTML=`<header><h2>Control de lavado de sal</h2></header>`+sl;$("#rSed").innerHTML=`<header><h2>Control de sedimentador</h2></header>`+sl;}
  $("#rBat").innerHTML=`<header><h2>Control de carga de bateas</h2><span class="cod">R-P-XX · bocas de silos limpias al inicio: ${d.bateas.bocas===true?"sí":d.bateas.bocas===false?"no":"sin marcar"}</span></header>`+
    (d.bateas.cargas.length?tabla(["Hora","Patente","Transportista","Chofer","Apta","Silo","Tapado","#Tn teóricas (radar SCADA)","Cuándo se llenó ese silo","Remito (balanza)","#Peso balanza (Tn)","#Dif. (Tn)","Observaciones"],d.bateas.cargas.map((b,i)=>{const z=tz[i]||{},o=z.ll||z.prev,rt=typeof b.t==="number"?b.t:o&&typeof o.t==="number"?o.t:null,de=typeof b.t==="number"?"lo anotó el operador en la planilla de bateas":o?(o.fecha?"el "+fmtF(o.fecha).slice(0,5)+", ":"ese día, ")+"de "+o.ini+" a "+(o.fin||"?"):"";return `<tr><td>${esc(b.h)}</td><td>${esc(b.pat)||'<span class="chip warn">Falta</span>'}</td><td>${esc(b.trans)||"—"}</td><td>${esc(b.chofer)||"—"}</td><td>${sino(b.apta)}</td><td>${esc(b.silo)||"—"}</td><td>${sino(b.tapado)}</td><td class="n" title="${esc(de)}">${rt!=null?nf(rt):"—"}</td><td>${rt!=null?esc(de):z.enCurso?"silo en llenado":"—"}</td><td>${esc(b.remito)||(z.v?esc(z.v.remito):"—")}</td><td class="n">${z.v?nf(z.v.neto_kg/1000,2):"—"}</td><td class="n">${z.v&&rt!=null?nf(z.v.neto_kg/1000-rt,2):"—"}</td><td>${esc(b.obs)}</td></tr>`}))+'<p class="nota">“Tn teóricas” es el peso que indicó el SCADA (sensor radar) en el llenado del silo del que se cargó la batea; sale del cuadro Producción de lavado, del último llenado de ese silo terminado antes de la carga, aunque sea de un día anterior. “Peso balanza” es el neto del remito que se hace en la balanza de camiones. La diferencia es balanza menos radar.</p>':'<p class="vacio">Sin bateas.</p>')+
    (d.notas.length&&!PUBLICA?`<p class="nota">Notas de carga: ${d.notas.map(esc).join(" · ")}</p>`:"");
}
function pintarParadas(){
  const rows=[];[...DIAS].reverse().forEach(d=>d.paradas.forEach(p=>rows.push(`<tr><td>${fmtF(d.fecha)}</td><td>${esc(p.de)}</td><td>${esc(p.a)}</td><td class="n">${minParada(p)}</td><td>${CAUSAS[p.causa]?`<span class="causa c${p.causa}">${p.causa}</span> ${CAUSAS[p.causa]}`:"—"}</td><td>${esc(p.equipo)||"—"}</td><td>${esc(p.motivo)}</td></tr>`)));
  $("#tParadas").innerHTML=`<thead><tr><th>Fecha</th><th>De</th><th>A</th><th class="n">Min</th><th>Causa</th><th>Equipo</th><th>Motivo</th></tr></thead><tbody>${rows.join("")||'<tr><td colspan="7" class="vacio">Sin paradas registradas.</td></tr>'}</tbody>`;
}
const MESES=["enero","febrero","marzo","abril","mayo","junio","julio","agosto","septiembre","octubre","noviembre","diciembre"];
function lunes(f){const d=new Date(f+"T12:00:00Z");d.setUTCDate(d.getUTCDate()-((d.getUTCDay()+6)%7));return d.toISOString().slice(0,10)}
function clave(f,tipo){return tipo==="dia"?f:tipo==="mes"?f.slice(0,7):tipo==="sem"?lunes(f):"todo"}
function rotulo(k,tipo){if(tipo==="dia")return fmtF(k);if(tipo==="mes"){const[a,m]=k.split("-");return MESES[+m-1][0].toUpperCase()+MESES[+m-1].slice(1)+" "+a}
  if(tipo==="sem"){const d=new Date(k+"T12:00:00Z");d.setUTCDate(d.getUTCDate()+6);return "Semana del "+fmtF(k).slice(0,5)+" al "+fmtF(d.toISOString().slice(0,10)).slice(0,5)}
  return "Todo lo cargado"}
function resumen(ds){
  const cs=ds.map(calc), ctrls=ds.flatMap(d=>d.sed.ctrl), bat=ds.flatMap(d=>d.bateas.cargas);
  const t=cs.reduce((s,c)=>s+c.t,0), hl=cs.reduce((s,c)=>s+c.hl,0), mp=cs.reduce((s,c)=>s+c.mp,0);
  return {dias:ds.filter(d=>!d.soloBateas).length,t,hl,mp,hm:hl-mp/60,incompletos:ds.filter(d=>!completoDia(d)).length,tC:cs.reduce((s,c)=>s+c.tF,0),hmC:cs.reduce((s,c)=>s+c.mF/60,0),arr:cs.filter(c=>c.arr!=null).reduce((s,c)=>s+c.arr,0),sinSal:ds.filter(d=>completoDia(d)&&!d.evento).reduce((s,d)=>s+calc(d).lento,0),perdFalla:ds.filter(d=>completoDia(d)&&d.evento).reduce((s,d)=>s+calc(d).lento,0),diasFalla:ds.filter(d=>d.evento).length,par:ds.reduce((s,d)=>s+d.paradas.length,0),ctrl:ctrls.length,esp:ds.reduce((s,d)=>s+ctrlEsperados(d),0),pcaOk:ctrls.filter(c=>!fueraPCA(c)).length,bat:bat.length,batRem:bat.filter(b=>b.pat).length,batNo:bat.filter(b=>b.apta===false).length,des:ds.reduce((s,d)=>s+d.desvios.length,0),sinRev:ds.filter(d=>!d.reviso&&!d.soloBateas).length};
}
function periodos(tipo){return [...new Set(DIAS.map(d=>clave(d.fecha,tipo)))].sort()}
function llenarPer(){const tipo=$("#indTipo").value, ps=periodos(tipo);$("#indPer").innerHTML=[...ps].reverse().map(k=>`<option value="${k}">${rotulo(k,tipo)}</option>`).join("");$("#indPer").value=ps[ps.length-1];}
function pintarInd(){
  if(!DIAS.length)return;
  const tipo=$("#indTipo").value; if(!$("#indPer").value)llenarPer();
  const per=$("#indPer").value, ds=DIAS.filter(d=>clave(d.fecha,tipo)===per), r=resumen(ds);
  const pct=(a,b)=>b?nf(a/b*100,0)+" %":"—";
  const nper=tipo==="sem"?notasDe("sem",per):tipo==="dia"?notasDe("dia",per):[];
  $("#indNotas").innerHTML=nper.length?`<div class="anal"><b>Notas de ${tipo==="sem"?"la semana":"este día"}</b>${nper.map(n=>notaHtml(n,false)).join("")}</div>`:"";
  $("#indDias").textContent=r.dias+" día"+(r.dias===1?"":"s")+" de lavado: "+ds.map(d=>fmtF(d.fecha).slice(0,5)+(d.soloBateas?" (solo bateas)":"")).join(", ");
  $("#resInd").innerHTML=dato("Sal a silos (radar)",nf(r.t,0)+" Tn",(r.dias?nf(r.t/r.dias,0):"0")+" Tn por día de lavado")+dato("Ritmo de lavado",r.hmC>0?nf(r.tC/r.hmC)+" Tn/h":"—",r.hmC>0?nf(r.tC/r.hmC/NORMAL*100,0)+" % de "+NORMAL+" Tn/h a silo · teóricas "+ALIM+" t/h":"")+dato("Puesta en marcha",(r.dias?nf(r.arr/r.dias,0)+" min":"—"),"promedio por día, del inicio al 1er silo")+dato("Llenados lentos","~"+r.sinSal+" min","minutos de más, días sin corte ni falla")+dato("Perdido por corte o falla","~"+r.perdFalla+" min",r.diasFalla+" día"+(r.diasFalla===1?"":"s")+" con corte de luz o falla de sistema")+dato("Disponibilidad",pct(r.hm,r.hl),"horas de marcha ÷ horas de lavado")+dato("Horas perdidas",nf(r.mp/60),r.par+" parada"+(r.par===1?"":"s"))+dato("Controles PCA",r.ctrl+" de "+r.esp,"hechos ÷ esperados")+dato("PCA en rango",pct(r.pcaOk,r.ctrl),r.ctrl+" controles")+dato("Bateas",r.bat,r.batNo?r.batNo+" rechazadas":"todas aptas")+dato("Bateas con patente",pct(r.batRem,r.bat),"anotada en la planilla")+dato("Desvíos",r.des,"de control de lavado")+dato("Días sin firma",r.sinRev+" de "+r.dias,"del encargado");
  const por={M:0,C:0,P:0,O:0,"?":0};ds.forEach(d=>d.paradas.forEach(p=>{por[CAUSAS[p.causa]?p.causa:"?"]+=minParada(p)}));
  if(!por["?"])delete por["?"];
  const mx=Math.max(1,...Object.values(por));
  $("#perCausa").textContent=rotulo(per,tipo);
  $("#bCausa").innerHTML=Object.keys(por).map(k=>`<div class="fila"><span>${CAUSAS[k]||"Sin causa"}</span><div class="pista"><i class="${CAUSAS[k]?"c"+k:""}" style="width:${por[k]/mx*100}%${CAUSAS[k]?"":";background:var(--muted)"}"></i></div><span style="text-align:right">${por[k]} min</span></div>`).join("");
  const cs=ds.map(calc), mt=Math.max(1,...cs.map(c=>c.th));
  $("#bTh").innerHTML=cs.map((c,i)=>ds[i].soloBateas?"":`<div class="fila"><span>${fmtF(ds[i].fecha)}</span><div class="pista"><i style="background:var(--accent);width:${c.th/mt*100}%"></i></div><span style="text-align:right">${nf(c.th)}</span></div>`).join("");
  $("#tPerd").innerHTML=`<thead><tr><th>Día</th><th class="n">Tn radar</th><th class="n">Ritmo</th><th class="n">Puesta en marcha</th><th class="n">Paradas anotadas</th><th class="n">Llenados lentos</th><th>Cuáles y a qué se atribuye</th></tr></thead><tbody>`+
    ds.map((d,i)=>{const c=cs[i],ok=completoDia(d);if(d.soloBateas)return `<tr><td>${fmtF(d.fecha)}</td><td class="n">—</td><td class="n">—</td><td class="n">—</td><td class="n">—</td><td class="n">—</td><td><span class="chip neu">Sin lavado</span> solo carga de bateas (${c.bat})</td></tr>`;return `<tr><td>${fmtF(d.fecha)}</td><td class="n">${nf(c.t)}</td><td class="n">${ok?nf(c.th)+" Tn/h · "+nf(c.th/NORMAL*100,0)+" %":"—"}</td><td class="n">${c.arr!=null?c.arr+" min":"—"}</td><td class="n">${c.mp} min</td><td class="n">${ok?"~"+c.lento+" min":"—"}</td><td>${!ok?'<span class="chip warn">Sin Tn</span> faltan Tn de los silos':!c.lento?'<span class="chip ok">Ritmo normal</span>':(d.evento?`<span class="chip bad">Corte de luz o falla</span> `:notasDe("dia",d.fecha).length?'<span class="chip ok">Analizado</span> ':'<span class="chip neu">A revisar</span> ')+esc(lentosTxt(c))+(notasDe("dia",d.fecha).length?`<br><b>Análisis:</b> ${notasDe("dia",d.fecha).map(n=>esc(n.txt)).join(" ")}`:"")}</td></tr>`}).join("")+`</tbody>`;
  const tv=ds.flatMap(d=>d.tolvas.filter(x=>x.ini&&x.fin).map(x=>({tg:x.tg,m:min(x.fin)-min(x.ini)})));
  const fTg=(n,a)=>{const v=a.filter(x=>x.m>=40).map(x=>x.m);return `<tr><td>${n}</td><td class="n">${v.length}</td><td class="n">${v.length?nf(v.reduce((s,x)=>s+x,0)/v.length):"—"}</td><td class="n">${v.length?Math.min(...v)+" a "+Math.max(...v):"—"}</td><td class="n">${a.length-v.length}</td><td class="n">${v.length?"~"+nf(CARGA_TG/(v.reduce((s,x)=>s+x,0)/v.length)*60):"—"}</td></tr>`};
  $("#tTg").innerHTML=`<thead><tr><th>Tolva</th><th class="n">Vaciados completos</th><th class="n">Promedio (min)</th><th class="n">Rango (min)</th><th class="n">Cortos (menos de 40 min)</th><th class="n">Alimentación estimada (t/h)</th></tr></thead><tbody>`+[1,2,3].map(n=>fTg("TG"+n,tv.filter(x=>String(x.tg)===String(n)))).join("")+fTg("Todas",tv)+`</tbody>`;
  const ct=tipo==="todo"?"sem":tipo;
  $("#cmpTit").textContent=ct==="dia"?"Comparativa por día":ct==="mes"?"Comparativa por mes":"Comparativa por semana";
  $("#tCmp").innerHTML=`<thead><tr><th>Período</th><th class="n">Días</th><th class="n">Tn radar</th><th class="n">Tn/día</th><th class="n">Tn/h</th><th class="n">Ritmo</th><th class="n">Llenados lentos (min)</th><th class="n">Corte o falla (min)</th><th class="n">Disponib.</th><th class="n">Min parados</th><th class="n">PCA hechos</th><th class="n">Bateas</th><th class="n">Desvíos</th></tr></thead><tbody>`+
    periodos(ct).reverse().map(k=>{const x=resumen(DIAS.filter(d=>clave(d.fecha,ct)===k));return `<tr class="${ct===tipo&&k===per?"marca":""}"><td>${rotulo(k,ct)}</td><td class="n">${x.dias}</td><td class="n">${nf(x.t,0)}</td><td class="n">${(x.dias?nf(x.t/x.dias,0):"—")}</td><td class="n">${x.hmC>0?nf(x.tC/x.hmC):"—"}</td><td class="n">${x.hmC>0?nf(x.tC/x.hmC/NORMAL*100,0)+" %":"—"}</td><td class="n">~${x.sinSal}</td><td class="n">~${x.perdFalla}</td><td class="n">${pct(x.hm,x.hl)}</td><td class="n">${x.mp}</td><td class="n">${x.ctrl}/${x.esp}</td><td class="n">${x.bat}</td><td class="n">${x.des}</td></tr>`}).join("")+`</tbody>`;
}
const CRUCES=[
 ["Carga de bateas","Chofer, patente y orden","PROD · Parvas y despachos","El operador no anota el remito (se hace en la balanza de camiones). La herramienta lo trae del despacho del día: cada batea cargada tiene que aparecer como viaje con su remito y su neto. Avisa remitos sin batea controlada y al revés."],
 ["Producción de lavado · tolvas","Fecha + TG","Registro de descarga en tolva","Las horas de cada tolva se ponen al lado de las descargas de granel (parva, neto). Da t de granel por hora de lavado y la pérdida por día."],
 ["Producción de lavado · silos","Fecha + silo","PROD · Lavado y envíos a planta","Los llenados de silo se comparan con las lecturas de silos y el plan del día."],
 ["Paradas con causa M","Equipo (tag del P&ID)","EQUIPOS · Planta de lavado","Cada parada de mantenimiento queda en la ficha del equipo: horas perdidas por equipo y qué conviene preventivar."],
 ["Control de lavado · desvíos","Fecha + silo","Carga de bateas","Si un silo tuvo un desvío, se ve qué bateas salieron de ese silo (trazabilidad hacia la refinería)."],
 ["Sedimentador · t/h","Fecha","Producción de lavado","El caudal de sal anotado se compara con las t/h reales del día."]
];
function pintarCruces(){$("#cruces").innerHTML=CRUCES.map(c=>`<div class="cruce"><div class="lado"><b>${c[0]}</b></div><div class="clave">${c[1]} →</div><div class="lado"><b>${c[2]}</b>${c[3]}</div></div>`).join("")}

const base=t=>String(t||"").normalize("NFD").replace(/[̀-ͯ]/g,"").toLowerCase().trim().split(/\s+/)[0]||"";
const plate=t=>String(t||"").replace(/\s+/g,"").toUpperCase();
// Lote vigente por parva: una línea por lote, con la fecha desde la que se usa (null = desde antes del primer día cargado)
const LOTES=[{parva:"1",cosecha:"Mar-24",desde:null,conf:true},{parva:"2",cosecha:"Feb-23",desde:null,conf:true}];
function loteDe(parva,fecha){const l=LOTES.filter(x=>x.parva===String(parva)&&(!x.desde||x.desde<=fecha)).slice(-1)[0];return l?l.cosecha+(l.conf?"":" (a confirmar)"):"sin lote cargado"}
function lotesDe(parva,fecha){return String(parva).split("/").map(p=>"P"+p+" "+loteDe(p,fecha)).join(" + ")}
function trazar(d){
  // empareja bateas con viajes del despacho por chofer, en orden
  const usados=new Set();
  const bat=d.bateas.cargas.map((b,i)=>{
    let v=null,modo="";
    if(b.remito){v=d.desp.viajes.find(x=>String(x.remito)===String(b.remito))||null;modo="anotado";}
    else{const k=d.desp.viajes.findIndex((x,j)=>!usados.has(j)&&base(x.chofer)===base(b.chofer));if(k>=0){usados.add(k);v=d.desp.viajes[k];modo="por chofer";}}
    const hb=min(b.h);
    const ll=d.silos.filter(s=>String(s.silo)===String(b.silo)&&s.fin&&min(s.fin)<=hb).slice(-1)[0]||null;
    const enCurso=!ll&&d.silos.some(s=>String(s.silo)===String(b.silo)&&min(s.ini)<=hb);
    let prev=null;
    if(!ll&&!enCurso){for(const p of DIAS.filter(x=>x.fecha<d.fecha).reverse()){const f=p.silos.filter(s=>String(s.silo)===String(b.silo)).slice(-1)[0];if(f){prev={...f,fecha:p.fecha};break;}}}
    const des=ll?d.desvios.filter(x=>String(x.silo)===String(b.silo)&&min(x.h)>=min(ll.ini)&&min(x.h)<=min(ll.fin)):[];
    return {b,v,modo,ll,enCurso,prev,des,i};
  });
  const sinBatea=d.desp.viajes.filter((x,j)=>!bat.some(r=>r.v===x));
  return {bat,sinBatea};
}
function pintarTraza(fecha,marca){
  const d=DIAS.find(x=>x.fecha===fecha); if(!d){$("#trCuerpo").innerHTML="";return;}
  const {bat,sinBatea}=trazar(d), c=calc(d);
  const docs=`<section class="reg"><header><h2><span class="paso">1 · </span>Documentos del ${fmtF(d.fecha)}</h2></header><div class="docs">`+
    (d.fuente&&d.fuente.link?`<a class="btn-pdf" href="${esc(d.fuente.link)}" target="_blank" rel="noopener">Registros del lavadero (PDF)</a>`:`<span class="chip warn">Registros: ${esc(d.fuente&&d.fuente.nombre||"sin PDF")}</span>`)+
    (d.desp.pdf&&d.desp.pdf.link?`<a class="btn-pdf" href="${esc(d.desp.pdf.link)}" target="_blank" rel="noopener">Despachos y tolva (PDF)</a>`:"")+
    `</div></section>`;
  const gr=d.granel.filas;
  const lotesHtml=`<h3>Lote vigente por parva</h3>`+tabla(["Parva","Cosecha","En uso desde","Estado"],LOTES.map(l=>`<tr><td>Parva ${esc(l.parva)}</td><td>${esc(l.cosecha)}</td><td>${l.desde?fmtF(l.desde):"antes del 02/11"}</td><td>${l.conf?'<span class="chip ok">Confirmado</span>':'<span class="chip warn">A confirmar</span>'}</td></tr>`))+`<p class="nota">Lote por orden de cosecha: en la parva las cosechas están mezcladas. Cuando se cierra un lote en el campo se agrega una línea con el siguiente y su fecha.</p>`;
  const atras=`<section class="reg"><header><h2><span class="paso">2 · </span>De dónde vino la sal</h2><span class="cod">Registro de descarga en tolva${d.granel.chofer?" · chofer "+esc(d.granel.chofer):""}</span></header>`+
    (gr.length?tabla(["Hora","Tolva","Parva","Lote de cosecha","#Neto t"],gr.map(g=>`<tr><td>${esc(String(g.horario).replace(".",":"))}</td><td>${esc(g.tolva)}</td><td>${esc(g.parva==="1/2"?"1 y 2 (mitad y mitad)":"Parva "+g.parva)}</td><td>${esc(lotesDe(g.parva,d.fecha))}</td><td class="n">${g.neto_t!=null?nf(g.neto_t):"S/P (34)"}</td></tr>`))+
      `<p class="nota">${gr.length} camiones de granel, unas ${nf(gr.reduce((s,g)=>s+(g.neto_t!=null?g.neto_t:34),0),0)} t.</p>`+lotesHtml
      :'<p class="vacio">El registro de tolva de este día no está cargado.</p>'+lotesHtml)+`</section>`;
  const proc=`<section class="reg"><header><h2><span class="paso">3 · </span>Proceso</h2><span class="cod">${d.inicio} a ${d.fin}${d.finEst?" (fin estimado)":""} · ${nf(c.t)} Tn radar</span></header>`+
    `<h3>Llenados de silos</h3>`+tabla(["Silo","Inicio","Lleno","#Tn radar"],d.silos.map(s=>`<tr><td>${esc(s.silo)}</td><td>${esc(s.ini)}</td><td>${esc(s.fin)||"—"}</td><td class="n">${typeof s.t==="number"?nf(s.t):"—"}</td></tr>`))+
    `<h3>Controles y eventos</h3><p class="nota" style="padding-top:4px">PCA: ${d.sed.ctrl.map(x=>`${esc(x.h)} → ${x.ml} ml/15 s ${fueraPCA(x)?"(fuera de rango)":"(en rango)"}`).join(" · ")||"sin controles"}. `+
    `Verificación previa: ${d.checklist.previa===true?"OK":"sin OK"}. Desvíos: ${d.desvios.map(x=>`${esc(x.h)} silo ${esc(x.silo)}: ${esc(x.desvio)}`).join(" · ")||"ninguno"}. `+
    `Paradas: ${d.paradas.map(p=>`${esc(p.de)}-${esc(p.a)} ${esc(p.motivo)}`).join(" · ")||"ninguna"}. Limpiezas y novedades: ${d.novedades.map(n=>`${esc(n.h)} ${esc(n.txt)}`).join(" · ")||"ninguna"}.</p></section>`;
  const adel=`<section class="reg"><header><h2><span class="paso">4 · </span>A dónde fue</h2><span class="cod">${esc(d.desp.destinatario||"Destino según despachos")}</span></header>`+
    tabla(["Hora","Chofer","Patente","Silo","Llenado de origen","Remito","#Neto kg","Cruce"],bat.map(r=>{
      const mk=marca&&((r.v&&String(r.v.remito)===marca)||(r.b.pat&&plate(r.b.pat)===marca));
      return `<tr class="${mk?"marca":""}"><td>${esc(r.b.h)}</td><td>${esc(r.b.chofer)}${r.b.trans?" ("+esc(r.b.trans)+")":""}</td><td>${esc(r.b.pat)||"—"}</td><td>${esc(r.b.silo)}</td><td>${r.ll?`${esc(r.ll.ini)}–${esc(r.ll.fin)}${typeof r.ll.t==="number"?" · "+nf(r.ll.t)+" Tn":""}`:r.enCurso?"Silo en llenado":r.prev?`${fmtF(r.prev.fecha).slice(0,5)} ${esc(r.prev.ini)}–${esc(r.prev.fin)||"?"}${typeof r.prev.t==="number"?" · "+nf(r.prev.t)+" Tn":""}`:"Día anterior sin cargar"}${r.des.length?' <span class="chip bad">desvío</span>':""}</td><td>${r.v?esc(r.v.remito):"—"}</td><td class="n">${r.v?Number(r.v.neto_kg).toLocaleString("es-AR"):"—"}</td><td>${r.v?`<span class="chip ${r.modo==="anotado"?"ok":"neu"}">${r.modo}</span>`:(r.b.obs||"").toLowerCase().includes("bolsa")?'<span class="chip neu">bolsas</span>':d.desp.cargado?'<span class="chip warn">sin despacho</span>':'<span class="chip warn">despacho sin cargar</span>'}</td></tr>`}))+
    (sinBatea.length?`<p class="nota"><span class="chip warn">Despachos sin batea controlada</span> ${sinBatea.map(v=>`remito ${esc(v.remito)} (${esc(v.chofer)})`).join(", ")}</p>`:"")+
    `<p class="nota">"Por chofer": el remito sale del despacho del mismo día, emparejado por chofer y orden, porque el operador de lavado no lo conoce (se hace en la balanza de camiones). Remitos y netos salen de la planilla de despacho (ticket de balanza). "Llenado de origen": el último llenado de ese silo terminado antes de la carga, aunque sea de un día anterior.</p></section>`;
  const muestras=d.desvios.filter(x=>x.muestra===true);
  const cal=`<section class="reg"><header><h2><span class="paso">5 · </span>Calidad</h2></header><p class="nota" style="padding-top:10px">Muestras tomadas: ${muestras.length?muestras.map(x=>`${esc(x.h)} silo ${esc(x.silo)}`).join(", "):"ninguna anotada"}. Los análisis de humedad y granulometría los hace Calidad en la Planta Refinería; se piden ahí con la fecha y el remito.</p></section>`;
  $("#trCuerpo").innerHTML=docs+atras+proc+adel+cal;
  // ficha del remito o patente buscado
  const r=marca&&bat.find(r=>(r.v&&String(r.v.remito)===marca)||(r.b.pat&&plate(r.b.pat)===marca));
  $("#trFicha").innerHTML=r?`<div class="ficha"><h3>${r.v?"Remito "+esc(r.v.remito):"Patente "+esc(r.b.pat)}</h3>`+
    [["Fecha y hora",fmtF(d.fecha)+" "+r.b.h],["Chofer",r.b.chofer+(r.b.trans?" ("+r.b.trans+")":"")],["Patente",r.b.pat||"—"],["Neto",r.v?Number(r.v.neto_kg).toLocaleString("es-AR")+" kg":"—"],["Silo",r.b.silo],["Llenado de origen",r.ll?r.ll.ini+"–"+r.ll.fin:r.enCurso?"en llenado":r.prev?fmtF(r.prev.fecha).slice(0,5)+" "+r.prev.ini+"–"+(r.prev.fin||"?"):"día anterior sin cargar"],["Batea apta / tapada",(r.b.apta?"Sí":"—")+" / "+(r.b.tapado?"Sí":"—")],["Desvíos en ese llenado",r.des.length?r.des.map(x=>x.desvio).join(", "):"Ninguno"],["Granel del día",d.granel.filas.length?[...new Set(d.granel.filas.map(g=>g.parva==="1/2"?"Parvas 1 y 2":"Parva "+g.parva))].join(", "):"sin registro"],["Lote de cosecha",d.granel.filas.length?[...new Set(d.granel.filas.map(g=>lotesDe(g.parva,d.fecha)))].join(", "):LOTES.map(l=>"P"+l.parva+" "+l.cosecha).join(" / ")]].map(([k,v])=>`<div><div class="k">${k}</div><div class="v">${esc(v)}</div></div>`).join("")+`</div>`:"";
}
function buscarTraza(q){
  q=String(q||"").trim(); if(!q){$("#trFicha").innerHTML="";pintarTraza($("#trDia").value);return;}
  const fm=q.match(/^(\d{1,2})[\/\-.](\d{1,2})(?:[\/\-.](\d{2,4}))?$/);
  if(fm){const f=`2026-${fm[2].padStart(2,"0")}-${fm[1].padStart(2,"0")}`;if(DIAS.some(d=>d.fecha===f)){$("#trDia").value=f;$("#trFicha").innerHTML="";pintarTraza(f);return;}}
  const P=plate(q);
  for(const d of [...DIAS].reverse()){
    const {bat}=trazar(d);
    if(bat.some(r=>(r.v&&String(r.v.remito)===q)||(r.b.pat&&plate(r.b.pat)===P))){$("#trDia").value=d.fecha;pintarTraza(d.fecha,/^\d+$/.test(q)?q:P);return;}
  }
  $("#trFicha").innerHTML=`<div class="aviso">No encontré "${esc(q)}" en los días cargados.</div>`;
}
function pintarTodo(){
  const sel=$("#selDia"), prev=sel.value;
  if(!DIAS.length){
    $("#aviso").className="aviso";$("#aviso").innerHTML="<b>Todavía no hay días cargados.</b> Los registros se cargan solos desde la carpeta de Drive “Registros Lavadero” (un PDF por día, nombrado DDMMAAAA), de lunes a viernes a las 9 y a las 12.";
    sel.innerHTML="";["#resDia","#alertas","#rProd","#rParadas","#rCtrl","#rSed","#rBat"].forEach(s=>$(s).innerHTML="");pintarParadas();return;
  }
  {const u=DIAS[DIAS.length-1];$("#aviso").className="aviso";$("#aviso").innerHTML=PUBLICA?`<b>Vista de solo lectura.</b> Registros diarios del lavadero, con datos al ${fmtF(u.fecha)} (${DIAS.length} días cargados).`:`<b>Herramienta en uso.</b> ${DIAS.length} días cargados, el último del ${fmtF(u.fecha)}. Cada día sale del PDF de la carpeta de Drive “Registros Lavadero” (nombre DDMMAAAA). Para sumar días: subir el PDF y pedirle a Clo “cargá registros de lavado”.`;}
  sel.innerHTML=[...DIAS].reverse().map(d=>`<option value="${d.fecha}">${fmtF(d.fecha)}</option>`).join("");
  sel.value=DIAS.some(d=>d.fecha===prev)?prev:DIAS[DIAS.length-1].fecha;
  $("#trDia").innerHTML=sel.innerHTML;$("#trDia").value=DIAS[DIAS.length-1].fecha;
  pintarDia();pintarParadas();pintarInd();pintarTraza($("#trDia").value);
}
$("#selDia").addEventListener("change",pintarDia);
$("#bitTipo").addEventListener("change",llenarBitRef);
$("#bitFiltro").addEventListener("change",pintarBit);
$("#bitLista").addEventListener("click",clicNotas);$("#analisis").addEventListener("click",clicNotas);$("#indNotas").addEventListener("click",clicNotas);
$("#bitGuardar").addEventListener("click",async()=>{const b=$("#bitGuardar"),t=$("#bitTxt");if(!t.value.trim()){$("#bitEstado").textContent="Escribí la nota antes de guardar.";return}b.disabled=true;const ok=await guardarNota($("#bitTipo").value,$("#bitRef").value,t.value,$("#bitEstado"));b.disabled=!puede;if(ok)t.value="";});
$("#indTipo").addEventListener("change",()=>{llenarPer();pintarInd()});
$("#indPer").addEventListener("change",pintarInd);
$("#trDia").addEventListener("change",()=>{$("#trBus").value="";$("#trFicha").innerHTML="";pintarTraza($("#trDia").value)});
$("#trBus").addEventListener("input",e=>buscarTraza(e.target.value));
document.querySelectorAll("nav.tabs button").forEach(b=>b.addEventListener("click",()=>{
  document.querySelectorAll("nav.tabs button").forEach(x=>x.setAttribute("aria-selected",x===b));
  ["dia","par","ind","tra","bit","cru","lee"].forEach(v=>$("#v-"+v).hidden=v!==b.dataset.v);
}));
pintarCruces();
